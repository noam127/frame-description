# Anthropic API Key (required)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# MongoDB Connection String (default: mongodb://localhost:27017/)
MONGODB_URI=mongodb://localhost:27017/

# Database name (default: video_analysis)
MONGODB_DATABASE=video_analysis

# Collection name (default: frame_descriptions)
MONGODB_COLLECTION=frame_descriptions

# Claude model to use (default: claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Max tokens for API response (default: 1024)
MAX_TOKENS=1024
